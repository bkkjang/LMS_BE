# 로컬 실행용 환경변수 예시. 이 파일을 .env 로 복사한 뒤 실제 값을 채워 넣으세요.
# .env 는 .gitignore 에 있으므로 커밋되지 않습니다.

# --- DB (기본값 있음, 로컬 MySQL 이면 생략 가능) ---
# DB_URL=jdbc:mysql://localhost:3306/bookdb?createDatabaseIfNotExist=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
# DB_USERNAME=root
# DB_PASSWORD=aivle

# --- 메일 (필수) ---
# Gmail 2단계 인증 후 발급한 "앱 비밀번호" 16자리
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx

# --- JWT (필수) ---
# 32바이트 이상 권장. 예: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# --- Naver 검색 API (필수) ---
NAVER_CLIENT_ID=your-client-id
NAVER_CLIENT_SECRET=your-client-secret

# --- OpenAI 프록시 (선택) ---
# OPENAI_API_KEY=sk-...
